SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
PRIVATE_KEY=
FRONTEND_URL=http://localhost:3000
PORT=8000

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# MoonPay Integration
NEXT_PUBLIC_MOONPAY_API_KEY=your_moonpay_api_key
NEXT_PUBLIC_MOONPAY_ENV=sandbox

# Treasury wallet for token distribution (private key with VERSE tokens)
TREASURY_PRIVATE_KEY=

# Deployed contract addresses (fill after running deploy.js)
VERSE_TOKEN_ADDRESS=
STAKING_VAULT_ADDRESS=
REWARD_DISTRIBUTOR_ADDRESS=
TREASURY_ADDRESS=
STRATEGY_MANAGER_ADDRESS=
ORACLE_MANAGER_ADDRESS=
EMERGENCY_PAUSE_ADDRESS=
WITHDRAWAL_MANAGER_ADDRESS=

# Price configuration (configurable, default 0.001)
PRICE_PER_VERSE_USD=0.001

# WARNING: TREASURY_PRIVATE_KEY should ONLY be used on testnet.
# For production, use an HSM or keystore-backed signer.
